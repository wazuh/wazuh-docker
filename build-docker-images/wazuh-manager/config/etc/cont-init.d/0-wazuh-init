# Variables
source /permanent_data.env

WAZUH_INSTALL_PATH=/var/wazuh-manager
WAZUH_CONFIG_MOUNT=/wazuh-config-mount

##############################################################################
# Aux functions
##############################################################################
print() {
  echo -e $1
}

error_and_exit() {
  echo "Error executing command: '$1'."
  echo 'Exiting.'
  exit 1
}

exec_cmd() {
  eval $1 > /dev/null 2>&1 || error_and_exit "$1"
}

exec_cmd_stdout() {
  eval $1 2>&1 || error_and_exit "$1"
}


##############################################################################
# This function will attempt to mount every directory in PERMANENT_DATA
# into the respective path.
# If the path is empty means permanent data volume is also empty, so a backup
# will be copied into it. Otherwise it will not be copied because there is
# already data inside the volume for the specified path.
##############################################################################

mount_permanent_data() {
  for permanent_dir in "${PERMANENT_DATA[@]}"; do
    data_tmp="${WAZUH_INSTALL_PATH}/data_tmp/permanent${permanent_dir}/"
    print ${data_tmp}
    # Check if the path is not empty
    if find ${permanent_dir} -mindepth 1 | read; then
      print "The path ${permanent_dir} is already mounted"
    elif [ ! -d "${data_tmp}" ]; then
      print "No permanent data snapshot for ${permanent_dir}, skipping"
    else
        print "Installing ${permanent_dir}"
        exec_cmd "cp -ar ${data_tmp}. ${permanent_dir}"
    fi
  done
}

##############################################################################
# This function will replace from the permanent data volume every file
# contained in PERMANENT_DATA_EXCP
# Some files as 'internal_options.conf' are saved as permanent data, but
# they must be updated to work properly if wazuh version is changed.
##############################################################################

safe_cp() {
    if cp -a "$1" "$2" 2>/dev/null; then
        return 0
    else
        echo "Warning: Could not copy $1 (may be read-only)"
        return 0
    fi
}

apply_exclusion_data() {
  for exclusion_path in "${PERMANENT_DATA_EXCP[@]}"; do
    snapshot="${WAZUH_INSTALL_PATH}/data_tmp/exclusion/${exclusion_path}"
    if [ ! -e "${snapshot}" ]
    then
      continue
    fi

    if [ -d "${snapshot}" ]
    then
      # Emptied rather than removed, so the entry can itself be a mount point, and
      # so a file dropped in a newer image does not survive next to its replacement.
      print "Updating ${exclusion_path}/"
      mkdir -p "${exclusion_path}"
      find "${exclusion_path}" -mindepth 1 -delete 2>/dev/null
      exec_cmd "safe_cp ${snapshot}/. ${exclusion_path}/"
    else
      DIR=$(dirname "${exclusion_path}")
      if [ ! -e "${DIR}" ]
      then
        mkdir -p "${DIR}"
      fi
      print "Updating ${exclusion_path}"
      exec_cmd "safe_cp ${snapshot} ${exclusion_path}"
    fi
  done
}

##############################################################################
# This function will rename in the permanent data volume every file
# contained in PERMANENT_DATA_MOVE
##############################################################################

move_data_files() {
  for mov_file in "${PERMANENT_DATA_MOVE[@]}"; do
    file_split=( $mov_file )
    if [ -e ${file_split[0]} ]
    then
      print "moving ${mov_file}"
      exec_cmd "mv -f ${mov_file}"
    fi
  done
}


##############################################################################
# This function will delete from the permanent data volume every file
# contained in PERMANENT_DATA_DEL
##############################################################################

remove_data_files() {
  for del_file in "${PERMANENT_DATA_DEL[@]}"; do
    if [ -e ${del_file} ]
    then
      print "Removing ${del_file}"
      exec_cmd "rm -f ${del_file}"
    fi
  done
}

##############################################################################
# Check the manager agent listener certificate
#
# etc/certs/remoted.* is read by remoted's HTTPS listener (<remote><https>) and
# by authd (<auth><ssl_manager_cert>). It is issued by wazuh-certs-tool.sh and
# mounted into the container; nothing generates it here, and the manager does
# not start without it. This only names the file that is missing, which the
# error the manager reports on its own does not.
##############################################################################

# Certificate paths in the configuration are Wazuh-home relative, as the rest of
# the manager configuration is.
resolve_wazuh_path() {
  case "$1" in
    /*) echo "$1" ;;
     *) echo "${WAZUH_INSTALL_PATH}/$1" ;;
  esac
}

# $1: XML tag, $2: enclosing block
get_conf_path() {
  sed -n "/<$2>/,/<\/$2>/s|.*<$1>\(.*\)</$1>.*|\1|p" \
    "${WAZUH_INSTALL_PATH}/etc/wazuh-manager.conf" | head -n1
}

# $1: certificate path, $2: key path
check_server_cert_pair() {
  local cert=$(resolve_wazuh_path "$1")
  local key=$(resolve_wazuh_path "$2")
  local missing=""

  [ -f "${cert}" ] && [ -r "${cert}" ] || missing="${cert}"
  [ -f "${key}" ] && [ -r "${key}" ] || missing="${missing:+${missing} }${key}"

  if [ -z "${missing}" ]
  then
    print "Manager agent listener certificate ${cert} found"
    return
  fi

  print "ERROR: the manager agent listener certificate is missing or unreadable: ${missing}"
  print "Issue it with wazuh-certs-tool.sh, which writes <node>-remoted.pem and"
  print "<node>-remoted-key.pem, and mount them at ${cert} and ${key}"
  print "owned by 0:wazuh-manager with mode 0640."
  print "The agent listener and agent enrollment do not start without them."
}

check_manager_server_certs() {
  local https_cert=$(get_conf_path certificate https)
  local https_key=$(get_conf_path key https)
  local authd_cert=$(get_conf_path ssl_manager_cert auth)
  local authd_key=$(get_conf_path ssl_manager_key auth)

  # authd's <ssl_manager_cert> is derived from the HTTPS listener's <certificate>
  # by the installation itself, so the two are one pair and one identity. A
  # mismatch can only come from hand-edited configuration.
  check_server_cert_pair "${https_cert:-etc/certs/remoted.pem}" \
                         "${https_key:-etc/certs/remoted-key.pem}"

  if [ "${authd_cert:-etc/certs/remoted.pem}" != "${https_cert:-etc/certs/remoted.pem}" ] || \
     [ "${authd_key:-etc/certs/remoted-key.pem}" != "${https_key:-etc/certs/remoted-key.pem}" ]
  then
    print "Warning: authd (${authd_cert}) and the HTTPS listener (${https_cert}) use different certificates; both must present the same manager identity"
  fi
}

##############################################################################
# Copy all files from $WAZUH_CONFIG_MOUNT to $WAZUH_INSTALL_PATH and respect
# destination files permissions
#
# For example, to mount the file /var/wazuh-manager/data/etc/wazuh-manager.conf, mount it at
# $WAZUH_CONFIG_MOUNT/etc/wazuh-manager.conf in your container and this code will
# replace the wazuh-manager.conf file in /var/wazuh-manager/data/etc with yours.
##############################################################################

mount_files() {
  if [ -e "$WAZUH_CONFIG_MOUNT" ]
  then
    print "Identified Wazuh configuration files to mount..."
    exec_cmd_stdout "cp --verbose -r $WAZUH_CONFIG_MOUNT/* $WAZUH_INSTALL_PATH"
  else
    print "No Wazuh configuration files to mount..."
  fi
}


##############################################################################
# Allow users to set the container hostname as <node_name> dynamically on
# container start.
#
# To use this:
# 1. Create your own wazuh-manager.conf file
# 2. In your wazuh-manager.conf file, set to_be_replaced_by_hostname as your node_name
# 3. Mount your custom wazuh-manager.conf file at $WAZUH_CONFIG_MOUNT/etc/wazuh-manager.conf
##############################################################################

set_custom_hostname() {
  sed -i 's/<node_name>to_be_replaced_by_hostname<\/node_name>/<node_name>'"${HOSTNAME}"'<\/node_name>/g' ${WAZUH_INSTALL_PATH}/etc/wazuh-manager.conf
}

##############################################################################
# Cluster key shared by the nodes of a cluster
#
# The image ships no cluster key and every container generates its own, which is
# what a single manager needs but not what a cluster needs: a master and its
# workers authenticate each other with one shared value.
#
# This follows the path convention the image already uses for
# WAZUH_CONFIG_MOUNT and /wazuh-migration: if the directory is there, the
# deployment has given the manager nodes somewhere to keep that value. The first
# node to start creates it and the rest read it, so the key is random per
# deployment and is stored neither in the image nor in the deployment files.
#
# WAZUH_CLUSTER_KEY still takes precedence, and remains the way to share a key
# between nodes that cannot share a volume, such as managers on different hosts.
##############################################################################

WAZUH_CLUSTER_KEY_MOUNT=/wazuh-cluster-key

# Sets SHARED_CLUSTER_KEY to the key held in the shared mount, creating it when
# this is the first node to get there. Left empty when there is no such mount.
read_shared_cluster_key() {
  SHARED_CLUSTER_KEY=""

  local key_file="${WAZUH_CLUSTER_KEY_MOUNT}/cluster.key"
  [ -d "${WAZUH_CLUSTER_KEY_MOUNT}" ] || return 0

  local attempt tmp_file
  for attempt in 1 2 3; do
    if [ -s "${key_file}" ]; then
      SHARED_CLUSTER_KEY=$(tr -d '[:space:]' < "${key_file}")
      [ -n "${SHARED_CLUSTER_KEY}" ] && return 0
    fi

    # The key is published with a hard link, which fails when the name is
    # already taken. It therefore only ever becomes visible complete: two nodes
    # starting at the same time can neither read a half-written value nor
    # overwrite each other's.
    tmp_file="${WAZUH_CLUSTER_KEY_MOUNT}/.cluster.key.$$"
    ( umask 077; openssl rand -hex 16 > "${tmp_file}" ) 2>/dev/null
    if ln "${tmp_file}" "${key_file}" 2>/dev/null; then
      print "Generated the cluster key shared by the manager nodes (${key_file})"
    fi
    rm -f "${tmp_file}"
  done

  [ -n "${SHARED_CLUSTER_KEY}" ] || \
    print "Warning: ${WAZUH_CLUSTER_KEY_MOUNT} is mounted but no cluster key could be read from it"
}

function_configure_wazuh_manager_conf() {
WAZUH_MANAGER_CONF="${WAZUH_INSTALL_PATH}/etc/wazuh-manager.conf"

# --------------------------
# Defaults based on WAZUH_MANAGER_CONF
# --------------------------
# A shared mount, when present, holds the key of the cluster this node belongs
# to, so it wins over whatever this node happened to have in its own volume.
if [[ -z "$WAZUH_CLUSTER_KEY" ]]; then
    read_shared_cluster_key
    WAZUH_CLUSTER_KEY="$SHARED_CLUSTER_KEY"
fi

if [[ -z "$WAZUH_CLUSTER_KEY" ]]; then
    WAZUH_CLUSTER_KEY=$(sed -n '/<cluster>/,/<\/cluster>/s/.*<key>\(.*\)<\/key>.*/\1/p' "$WAZUH_MANAGER_CONF" | head -n1)
fi

# The image ships an empty <key>: the installer's build-time key is cleared in
# the Dockerfile so it is not published inside the image. When neither the
# environment nor the configuration provides a key, generate one here, the same
# way the manager server certificate is generated when it is absent, so no two
# containers from the same image share a cluster secret.
#
# The key is written into etc/wazuh-manager.conf, which lives in the manager
# 'etc' volume (permanent data), so it stays stable across restarts and
# container recreation, and is regenerated only on a fresh volume.
#
# Nodes that must form a cluster cannot each invent their own key: they either
# share the ${WAZUH_CLUSTER_KEY_MOUNT} volume, as the multi-node deployment
# does, or receive the same WAZUH_CLUSTER_KEY.
if [[ -z "$WAZUH_CLUSTER_KEY" ]]; then
    WAZUH_CLUSTER_KEY=$(openssl rand -hex 16)
    print "No cluster key configured: generated one unique to this node. Set WAZUH_CLUSTER_KEY to the same value on every node that must join the same cluster."

    if [[ "$WAZUH_NODE_TYPE" == "worker" ]]; then
        print "Warning: this is a worker node and a key generated here cannot match the master's, so it will not join the cluster. Set WAZUH_CLUSTER_KEY on every node, or mount a volume shared by the manager nodes on ${WAZUH_CLUSTER_KEY_MOUNT}."
    fi
fi

# Node type logic
if [[ "$WAZUH_NODE_TYPE" != "worker" ]]; then
    WAZUH_NODE_TYPE="master"
fi

# Default node name → HOSTNAME if not defined
WAZUH_NODE_NAME="${WAZUH_NODE_NAME:-$HOSTNAME}"

# --------------------------
# Replace Indexer Hosts
# --------------------------
if [[ -n "$WAZUH_INDEXER_HOSTS" ]]; then
    TMP_HOSTS=$(mktemp)
    {
        echo "    <hosts>"
        IFS=',' read -ra NODES <<< "$WAZUH_INDEXER_HOSTS"
        for NODE in "${NODES[@]}"; do
            NODE="${NODE#"${NODE%%[![:space:]]*}"}"
            NODE="${NODE#http://}"; NODE="${NODE#https://}"
            if [[ "$NODE" == *:* ]]; then
                HOST="${NODE%:*}"; PORT="${NODE##*:}"
            else
                HOST="$NODE"; PORT=9200
            fi
            [[ "$PORT" =~ ^[0-9]+$ ]] || { print "Invalid indexer host '$NODE'" >&2; exit 1; }
            echo "      <host>https://${HOST}:${PORT}</host>"
        done
        echo "    </hosts>"
    } > "$TMP_HOSTS";
    sed -i -e '/<indexer>/,/<\/indexer>/{ /<hosts>/,/<\/hosts>/{ /<hosts>/r '"$TMP_HOSTS" \
            -e 'd }}' "$WAZUH_MANAGER_CONF";
    rm -f "$TMP_HOSTS";

fi

# --------------------------
# Remote: listen address
#
# The packaged configuration binds remoted to 127.0.0.1, which inside a
# container leaves it reachable only from the container itself: the published
# 1517 (and the legacy 1514) would refuse every agent connection. Binding on
# all interfaces is scoped to the container network namespace, so what is
# actually reachable from outside stays governed by the published ports.
# --------------------------
# Escapes &, \ and | (the sed replacement delimiter used below) so a value
# containing any of them is inserted literally instead of being interpreted
# by sed as a backreference, an escape, or the end of the substitution.
escape_repl() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }

WAZUH_REMOTE_BIND_ADDR="${WAZUH_REMOTE_BIND_ADDR:-0.0.0.0}"

sed -i "/<https>/,/<\/https>/ s|<bind_addr>.*</bind_addr>|<bind_addr>$(escape_repl "$WAZUH_REMOTE_BIND_ADDR")</bind_addr>|" "$WAZUH_MANAGER_CONF"
sed -i "/<legacy>/,/<\/legacy>/ s|<local_ip>.*</local_ip>|<local_ip>$(escape_repl "$WAZUH_REMOTE_BIND_ADDR")</local_ip>|" "$WAZUH_MANAGER_CONF"

# --------------------------
# Cluster: node_name
# --------------------------
sed -i "/<cluster>/,/<\/cluster>/ s|<node_name>.*</node_name>|<node_name>$(escape_repl "$WAZUH_NODE_NAME")</node_name>|" "$WAZUH_MANAGER_CONF"

# --------------------------
# Cluster: node_type
# --------------------------
sed -i "/<cluster>/,/<\/cluster>/ s|<node_type>.*</node_type>|<node_type>$(escape_repl "$WAZUH_NODE_TYPE")</node_type>|" "$WAZUH_MANAGER_CONF"

# --------------------------
# Cluster: key
# --------------------------
sed -i "/<cluster>/,/<\/cluster>/ s|<key>.*</key>|<key>$(escape_repl "$WAZUH_CLUSTER_KEY")</key>|" "$WAZUH_MANAGER_CONF"

# --------------------------
# Cluster: bind_addr
# --------------------------
WAZUH_CLUSTER_BIND_ADDR="${WAZUH_CLUSTER_BIND_ADDR:-0.0.0.0}"
sed -i "/<cluster>/,/<\/cluster>/ s|<bind_addr>.*</bind_addr>|<bind_addr>$(escape_repl "$WAZUH_CLUSTER_BIND_ADDR")</bind_addr>|" "$WAZUH_MANAGER_CONF"

# --------------------------
# Cluster: nodes list
# --------------------------
if [[ -n "$WAZUH_CLUSTER_NODES" ]]; then
    TMP_NODES=$(mktemp)
    {
        echo "    <nodes>"
        for N in $WAZUH_CLUSTER_NODES; do
            echo "        <node>$N</node>"
        done
        echo "    </nodes>"
    } > "$TMP_NODES";
    sed -i -e '/<cluster>/,/<\/cluster>/{ /<nodes>/,/<\/nodes>/{ /<nodes>/r '"$TMP_NODES" \
            -e 'd }}' "$WAZUH_MANAGER_CONF";
    rm -f "$TMP_NODES";
fi

echo "Wazuh manager config modified successfully."
}

##############################################################################
# Set correct ownership for Wazuh related directories
# on container start.
##############################################################################

configure_permissions() {
  chown -R wazuh-manager:wazuh-manager /var/wazuh-manager/queue/rids
}

##############################################################################
# Change any legacy user/group to wazuh-manager user/group
##############################################################################

set_correct_permOwner() {
  find /var/wazuh-manager/ -group 997 -exec chown :101 {} +
  find /var/wazuh-manager/ -group 999 -exec chown :101 {} +
  find /var/wazuh-manager/ -user 999 -exec chown 101 {} +
}

##############################################################################
# Main function
##############################################################################

main() {
  # Mount permanent data  (i.e. wazuh-manager.conf)
  mount_permanent_data

  # Restore files stored in permanent data that are not permanent  (i.e. internal_options.conf)
  apply_exclusion_data

  # Apply correct permission and ownership
  set_correct_permOwner

  # Rename files stored in permanent data (i.e. queue/wazuh-manager)
  move_data_files

  # Remove some files in permanent_data (i.e. .template.db)
  remove_data_files

  # Mount selected files (WAZUH_CONFIG_MOUNT) to container
  mount_files

  # Allow setting custom hostname
  set_custom_hostname

  # Configure wazuh-manager.conf based on environment variables
  function_configure_wazuh_manager_conf

  # After mount_files and the configuration rewrite, so a mounted configuration
  # with custom certificate paths is honoured.
  check_manager_server_certs

  # Delete temporary data folder
  rm -rf ${WAZUH_INSTALL_PATH}/data_tmp

  # Set correct ownership for Wazuh related directories
  configure_permissions
}

main
