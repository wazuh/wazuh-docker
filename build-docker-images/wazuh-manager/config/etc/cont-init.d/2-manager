#!/bin/bash

source /permanent_data.env

##############################################################################
# Migration sequence
# Detect if there is a mounted volume on /wazuh-migration and copy the data
# to the manager, finally it will create a flag ".migration-completed" inside
# the mounted volume
##############################################################################

function __colortext()
{
  echo -e " \e[1;$2m$1\e[0m"
}

function echogreen()
{
  echo $(__colortext "$1" "32")
}

function echoyellow()
{
  echo $(__colortext "$1" "33")
}

function echored()
{
  echo $(__colortext "$1" "31")
}

function_wazuh_migration(){
  if [ -d "/wazuh-migration" ]; then
    if [ ! -e /wazuh-migration/.migration-completed ]; then
      if [ ! -e /wazuh-migration/global.db ]; then
        echoyellow "The volume mounted on /wazuh-migration does not contain all the correct files."
        return
      fi

      \cp -f /wazuh-migration/data/etc/wazuh-manager.conf ${WAZUH_MANAGER_CONF_DIR}/wazuh-manager.conf
      chown root:wazuh-manager ${WAZUH_MANAGER_CONF_DIR}/wazuh-manager.conf
      chmod 640 ${WAZUH_MANAGER_CONF_DIR}/wazuh-manager.conf

      \cp -f /wazuh-migration/data/etc/client.keys ${WAZUH_MANAGER_CONF_DIR}/client.keys
      chown wazuh-manager:wazuh-manager ${WAZUH_MANAGER_CONF_DIR}/client.keys
      chmod 640 ${WAZUH_MANAGER_CONF_DIR}/client.keys

      \cp -f /wazuh-migration/data/etc/shared/default/agent.conf ${WAZUH_MANAGER_CONF_DIR}/shared/default/agent.conf
      chown wazuh-manager:wazuh-manager ${WAZUH_MANAGER_CONF_DIR}/shared/default/agent.conf
      chmod 660 ${WAZUH_MANAGER_CONF_DIR}/shared/default/agent.conf

      \cp -f /wazuh-migration/data/etc/decoders/* ${WAZUH_MANAGER_CONF_DIR}/decoders/
      chown wazuh-manager:wazuh-manager ${WAZUH_MANAGER_CONF_DIR}/decoders/*
      chmod 660 ${WAZUH_MANAGER_CONF_DIR}/decoders/*
      \cp -f /wazuh-migration/data/etc/rules/* ${WAZUH_MANAGER_CONF_DIR}/rules/
      chown wazuh-manager:wazuh-manager ${WAZUH_MANAGER_CONF_DIR}/rules/*
      chmod 660 ${WAZUH_MANAGER_CONF_DIR}/rules/*

      \cp -f /wazuh-migration/global.db /var/wazuh-manager/queue/db/global.db
      chown wazuh-manager:wazuh-manager /var/wazuh-manager/queue/db/global.db
      chmod 640 /var/wazuh-manager/queue/db/global.db

      # mark volume as migrated
      touch /wazuh-migration/.migration-completed

      echogreen "Migration completed succesfully"
    else
      echoyellow "This volume has already been migrated. You may proceed and remove it from the mount point (/wazuh-migration)"
    fi
  fi
}

function_entrypoint_scripts() {
  # It will run every .sh script located in entrypoint-scripts folder in lexicographical order
  if [ -d "/entrypoint-scripts/" ]
  then
    for script in `ls /entrypoint-scripts/*.sh | sort -n`; do
      bash "$script"
    done
  fi
}

# Migrate data from /wazuh-migration volume
function_wazuh_migration

# run entrypoint scripts
function_entrypoint_scripts

# Start Wazuh
/var/wazuh-manager/bin/wazuh-manager-control start
