#
# Resolves the manager's credentials before any daemon starts. They come from
# the wazuh-credentials secret (config/credentials/manager.env, created by
# tools/utils/deployment/credentials-conf.sh), or from the environment; a key
# the manager cannot resolve stops the container. See docs/ref/credentials.md.
#
# wazuh-manager-control start runs the resolver's pre-start check again before
# the daemons start; running it here first stops the container with the
# resolver's own lines while the deployment credentials are still in the
# environment.

WAZUH_HOME=/var/wazuh-manager
RESOLVER="${WAZUH_HOME}/bin/wazuh-manager-resolve-credentials"
RBAC_DB="${WAZUH_HOME}/api/configuration/security/rbac.db"

if [ ! -x "${RESOLVER}" ]; then
  echo "credentials: ${RESOLVER} is missing from this image" >&2
  exit 1
fi

. /credentials-env.sh
load_credentials || exit 1

# Names the Compose files and Kubernetes manifests have always used.
if [ -z "${WAZUH_INDEXER_MANAGER_PASSWORD}" ] && [ -n "${INDEXER_PASSWORD}" ]; then
  export WAZUH_INDEXER_MANAGER_PASSWORD="${INDEXER_PASSWORD}"
fi
if [ -n "${INDEXER_USERNAME}" ] && [ "${INDEXER_USERNAME}" != "wazuh-manager" ]; then
  echo "credentials: INDEXER_USERNAME is ignored; the manager authenticates to the indexer as wazuh-manager" >&2
fi

# Until rbac.db is seeded, the resolver would generate the Server API
# passwords itself, inside this container, where nobody could read them back.
# A worker seeds nothing: the Server API runs on the master.
missing=""
if [ ! -s "${RBAC_DB}" ] && \
   [ "$("${WAZUH_HOME}/bin/wazuh-manager-conf" get cluster.node_type 2>/dev/null)" != "worker" ]; then
  for key in WAZUH_MANAGER_API_PASSWORD WAZUH_MANAGER_WUI_PASSWORD; do
    [ -n "${!key}" ] || missing="${missing} ${key}"
  done
fi
if [ -n "${missing}" ]; then
  for key in ${missing}; do
    echo "credentials: MISSING ${key}" >&2
  done
  echo "credentials: create the deployment credentials with tools/utils/deployment/credentials-conf.sh" >&2
  exit 1
fi

if ! "${RESOLVER}" --prestart -H "${WAZUH_HOME}"; then
  echo "credentials: the manager cannot start until the problems above are solved;" >&2
  echo "credentials: values go in config/credentials/manager.env (created by tools/utils/deployment/credentials-conf.sh)," >&2
  echo "credentials: certificates under /etc/wazuh-manager/certs (see docs/ref/security.md)" >&2
  exit 1
fi
